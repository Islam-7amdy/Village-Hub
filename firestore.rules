rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global default deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Core helper primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && (
        request.auth.token.email_verified == true ||
        (request.auth.token.phone_number != null && request.auth.token.phone_number.size() >= 8)
      );
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isNotBannedUser() {
      return !exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isBanned', false) != true;
    }

    // Validation Helpers
    function isValidVillage(data) {
      return data.keys().hasAll(['id', 'nameAr', 'nameEn', 'baseDeliveryFeeEgp', 'perKmFeeEgp', 'isActive', 'createdAt']) &&
        data.keys().hasOnly([
          'id', 'nameAr', 'nameEn', 'governorateAr', 'governorateEn',
          'descriptionAr', 'descriptionEn', 'baseDeliveryFeeEgp', 'perKmFeeEgp',
          'colorCode', 'logoIcon', 'logoUrl', 'isActive', 'createdAt'
        ]) &&
        isValidId(data.id) &&
        data.nameAr is string && data.nameAr.size() >= 1 && data.nameAr.size() <= 80 &&
        data.nameEn is string && data.nameEn.size() >= 1 && data.nameEn.size() <= 80 &&
        (!('governorateAr' in data) || (data.governorateAr is string && data.governorateAr.size() <= 80)) &&
        (!('governorateEn' in data) || (data.governorateEn is string && data.governorateEn.size() <= 80)) &&
        (!('descriptionAr' in data) || (data.descriptionAr is string && data.descriptionAr.size() <= 250)) &&
        (!('descriptionEn' in data) || (data.descriptionEn is string && data.descriptionEn.size() <= 250)) &&
        data.baseDeliveryFeeEgp is number && data.baseDeliveryFeeEgp >= 0 && data.baseDeliveryFeeEgp <= 500 &&
        data.perKmFeeEgp is number && data.perKmFeeEgp >= 0 && data.perKmFeeEgp <= 200 &&
        (!('colorCode' in data) || (data.colorCode in ['amber', 'emerald', 'blue', 'teal', 'rose', 'indigo'])) &&
        (!('logoIcon' in data) || (data.logoIcon in ['wheat', 'trees', 'landmark', 'waves', 'sun', 'building', 'sprout', 'compass'])) &&
        (!('logoUrl' in data) || (data.logoUrl is string && data.logoUrl.size() <= 45000)) &&
        data.isActive is bool &&
        data.createdAt is timestamp;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'displayName', 'phone', 'role', 'villageId', 'providerStatus', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly([
          'uid', 'displayName', 'email', 'phone', 'address', 'photoUrl', 'role', 'villageId', 'neighborhood',
          'providerStatus', 'serviceCategory', 'serviceTitle', 'serviceFeeEgp', 'serviceBio',
          'isBanned', 'banUntilMs', 'banReason', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.uid) &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80 &&
        (!('email' in data) || (data.email is string && data.email.size() <= 120)) &&
        data.phone is string && data.phone.size() >= 8 && data.phone.size() <= 30 &&
        (!('address' in data) || (data.address is string && data.address.size() <= 200)) &&
        (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 45000)) &&
        data.role in ['resident', 'provider'] &&
        isValidId(data.villageId) &&
        (!('neighborhood' in data) || (data.neighborhood is string && data.neighborhood.size() <= 100)) &&
        data.providerStatus in ['none', 'pending', 'approved', 'rejected'] &&
        (!('serviceCategory' in data) || (isValidId(data.serviceCategory) && data.serviceCategory.size() <= 40)) &&
        (!('serviceTitle' in data) || (data.serviceTitle is string && data.serviceTitle.size() <= 100)) &&
        (!('serviceFeeEgp' in data) || (data.serviceFeeEgp is string && data.serviceFeeEgp.size() <= 60)) &&
        (!('serviceBio' in data) || (data.serviceBio is string && data.serviceBio.size() <= 400)) &&
        (!('isBanned' in data) || (data.isBanned is bool)) &&
        (!('banUntilMs' in data) || (data.banUntilMs is number)) &&
        (!('banReason' in data) || (data.banReason is string && data.banReason.size() <= 200)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidBannedPhone(data) {
      return data.keys().hasAll(['phone', 'banUntilMs', 'isPermanent', 'createdAt']) &&
        data.keys().hasOnly(['phone', 'userId', 'userName', 'reason', 'banUntilMs', 'isPermanent', 'createdAt']) &&
        isValidId(data.phone) &&
        data.phone.size() >= 8 && data.phone.size() <= 30 &&
        (!('userId' in data) || (data.userId is string && data.userId.size() <= 128)) &&
        (!('userName' in data) || (data.userName is string && data.userName.size() <= 80)) &&
        (!('reason' in data) || (data.reason is string && data.reason.size() <= 200)) &&
        data.banUntilMs is number &&
        data.isPermanent is bool &&
        data.createdAt is timestamp;
    }

    function isValidUserCart(data) {
      return data.keys().hasAll(['ownerId', 'villageId', 'items', 'updatedAt']) &&
        data.keys().hasOnly(['ownerId', 'villageId', 'items', 'updatedAt']) &&
        isValidId(data.ownerId) &&
        isValidId(data.villageId) &&
        data.items is list && data.items.size() <= 50 &&
        data.updatedAt is timestamp;
    }

    function isValidProviderListing(data) {
      return data.keys().hasAll(['ownerId', 'villageId', 'nameAr', 'nameEn', 'category', 'specialtyAr', 'specialtyEn', 'phone', 'status', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly([
          'ownerId', 'villageId', 'nameAr', 'nameEn', 'category', 'specialtyAr', 'specialtyEn',
          'phone', 'neighborhoodAr', 'neighborhoodEn', 'priceLabelAr', 'priceLabelEn',
          'bioAr', 'bioEn',
          'isAcceptingOrders', 'manualClosedReason', 'scheduleEnabled', 'openTime', 'closeTime', 'workingDays',
          'status', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.ownerId) &&
        isValidId(data.villageId) &&
        data.nameAr is string && data.nameAr.size() >= 1 && data.nameAr.size() <= 80 &&
        data.nameEn is string && data.nameEn.size() >= 1 && data.nameEn.size() <= 80 &&
        isValidId(data.category) && data.category.size() <= 40 &&
        data.specialtyAr is string && data.specialtyAr.size() >= 1 && data.specialtyAr.size() <= 120 &&
        data.specialtyEn is string && data.specialtyEn.size() >= 1 && data.specialtyEn.size() <= 120 &&
        data.phone is string && data.phone.size() >= 3 && data.phone.size() <= 30 &&
        (!('neighborhoodAr' in data) || (data.neighborhoodAr is string && data.neighborhoodAr.size() <= 100)) &&
        (!('neighborhoodEn' in data) || (data.neighborhoodEn is string && data.neighborhoodEn.size() <= 100)) &&
        (!('priceLabelAr' in data) || (data.priceLabelAr is string && data.priceLabelAr.size() <= 60)) &&
        (!('priceLabelEn' in data) || (data.priceLabelEn is string && data.priceLabelEn.size() <= 60)) &&
        (!('bioAr' in data) || (data.bioAr is string && data.bioAr.size() <= 400)) &&
        (!('bioEn' in data) || (data.bioEn is string && data.bioEn.size() <= 400)) &&
        (!('isAcceptingOrders' in data) || (data.isAcceptingOrders is bool)) &&
        (!('manualClosedReason' in data) || (data.manualClosedReason is string && data.manualClosedReason.size() <= 120)) &&
        (!('scheduleEnabled' in data) || (data.scheduleEnabled is bool)) &&
        (!('openTime' in data) || (data.openTime is string && data.openTime.size() <= 10 && data.openTime.matches('^([01]\\d|2[0-3]):[0-5]\\d$'))) &&
        (!('closeTime' in data) || (data.closeTime is string && data.closeTime.size() <= 10 && data.closeTime.matches('^([01]\\d|2[0-3]):[0-5]\\d$'))) &&
        (!('workingDays' in data) || (data.workingDays is list && data.workingDays.size() <= 7 && data.workingDays.hasOnly([0, 1, 2, 3, 4, 5, 6]))) &&
        data.status in ['pending', 'approved', 'rejected'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidVillageAd(data) {
      return data.keys().hasAll(['ownerId', 'authorName', 'villageId', 'title', 'description', 'category', 'contactPhone', 'status', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly([
          'ownerId', 'authorName', 'villageId', 'title', 'description', 'category',
          'priceText', 'contactPhone', 'durationPlan', 'durationDays', 'costEgp', 'expiresAtMs',
          'status', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.ownerId) &&
        data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 80 &&
        isValidId(data.villageId) &&
        data.title is string && data.title.size() >= 2 && data.title.size() <= 120 &&
        data.description is string && data.description.size() >= 4 && data.description.size() <= 500 &&
        data.category in ['offer', 'shop', 'property', 'job', 'event'] &&
        (!('priceText' in data) || (data.priceText is string && data.priceText.size() <= 60)) &&
        data.contactPhone is string && data.contactPhone.size() >= 3 && data.contactPhone.size() <= 30 &&
        (!('durationPlan' in data) || (data.durationPlan in ['week', 'month'])) &&
        (!('durationDays' in data) || (data.durationDays is number && data.durationDays >= 1 && data.durationDays <= 365)) &&
        (!('costEgp' in data) || (data.costEgp is number && data.costEgp >= 0 && data.costEgp <= 50000)) &&
        (!('expiresAtMs' in data) || (data.expiresAtMs is number)) &&
        data.status in ['pending', 'approved', 'rejected'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidBooking(data) {
      return data.keys().hasAll(['ownerId', 'villageId', 'serviceType', 'title', 'providerName', 'customerName', 'customerPhone', 'status', 'createdAt']) &&
        data.keys().hasOnly([
          'ownerId', 'villageId', 'serviceType', 'title', 'providerOwnerId', 'providerName', 'customerName',
          'customerPhone', 'address', 'distanceKm', 'deliveryFeeEgp', 'codFeeEgp', 'subtotalEgp',
          'totalAmountEgp', 'date', 'time', 'notes', 'itemsSummary',
          'paymentMethod', 'paymentStatus', 'providerVisible', 'instaPaySender', 'instaPayCustomerRef',
          'paymentVerifiedAt', 'transactionRef', 'deliveryConfirmedRef', 'deliveryConfirmedAt',
          'settlementStatus', 'settledAt', 'adminNotes', 'status', 'createdAt'
        ]) &&
        isValidId(data.ownerId) &&
        isValidId(data.villageId) &&
        isValidId(data.serviceType) && data.serviceType.size() <= 40 &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 160 &&
        (!('providerOwnerId' in data) || isValidId(data.providerOwnerId)) &&
        data.providerName is string && data.providerName.size() >= 1 && data.providerName.size() <= 100 &&
        data.customerName is string && data.customerName.size() >= 1 && data.customerName.size() <= 80 &&
        data.customerPhone is string && data.customerPhone.size() >= 3 && data.customerPhone.size() <= 30 &&
        (!('address' in data) || (data.address is string && data.address.size() <= 160)) &&
        (!('distanceKm' in data) || (data.distanceKm is number && data.distanceKm >= 0 && data.distanceKm <= 200)) &&
        (!('deliveryFeeEgp' in data) || (data.deliveryFeeEgp is number && data.deliveryFeeEgp >= 0 && data.deliveryFeeEgp <= 5000)) &&
        (!('codFeeEgp' in data) || (data.codFeeEgp is number && data.codFeeEgp >= 0 && data.codFeeEgp <= 500)) &&
        (!('subtotalEgp' in data) || (data.subtotalEgp is number && data.subtotalEgp >= 0 && data.subtotalEgp <= 100000)) &&
        (!('totalAmountEgp' in data) || (data.totalAmountEgp is number && data.totalAmountEgp >= 0 && data.totalAmountEgp <= 100000)) &&
        (!('date' in data) || (data.date is string && data.date.size() <= 40)) &&
        (!('time' in data) || (data.time is string && data.time.size() <= 40)) &&
        (!('notes' in data) || (data.notes is string && data.notes.size() <= 400)) &&
        (!('itemsSummary' in data) || (data.itemsSummary is string && data.itemsSummary.size() <= 400)) &&
        (!('paymentMethod' in data) || (data.paymentMethod in ['instapay', 'cod'])) &&
        (!('paymentStatus' in data) || (data.paymentStatus in ['paid', 'pending_verification', 'pending_cod', 'rejected'])) &&
        (!('providerVisible' in data) || (data.providerVisible is bool)) &&
        (!('instaPaySender' in data) || (data.instaPaySender is string && data.instaPaySender.size() <= 60)) &&
        (!('instaPayCustomerRef' in data) || (data.instaPayCustomerRef is string && data.instaPayCustomerRef.size() <= 60)) &&
        (!('paymentVerifiedAt' in data) || (data.paymentVerifiedAt is string && data.paymentVerifiedAt.size() <= 40)) &&
        (!('transactionRef' in data) || (data.transactionRef is string && data.transactionRef.size() <= 60)) &&
        (!('deliveryConfirmedRef' in data) || (data.deliveryConfirmedRef is string && data.deliveryConfirmedRef.size() <= 60)) &&
        (!('deliveryConfirmedAt' in data) || (data.deliveryConfirmedAt is string && data.deliveryConfirmedAt.size() <= 40)) &&
        (!('settlementStatus' in data) || (data.settlementStatus in ['pending', 'settled'])) &&
        (!('settledAt' in data) || (data.settledAt is string && data.settledAt.size() <= 40)) &&
        (!('adminNotes' in data) || (data.adminNotes is string && data.adminNotes.size() <= 300)) &&
        data.status in ['pending', 'preparing', 'on_the_way', 'confirmed', 'completed', 'cancelled'] &&
        data.createdAt is timestamp;
    }

    function isValidReview(data) {
      return data.keys().hasAll(['ownerId', 'targetId', 'villageId', 'author', 'rating', 'comment', 'date', 'isVerifiedResident', 'createdAt']) &&
        data.keys().hasOnly([
          'ownerId', 'bookingId', 'targetId', 'villageId', 'author', 'neighborhood', 'rating',
          'comment', 'date', 'isVerifiedResident', 'createdAt'
        ]) &&
        isValidId(data.ownerId) &&
        (!('bookingId' in data) || isValidId(data.bookingId)) &&
        data.targetId is string && data.targetId.size() >= 1 && data.targetId.size() <= 128 &&
        isValidId(data.villageId) &&
        data.author is string && data.author.size() >= 1 && data.author.size() <= 80 &&
        (!('neighborhood' in data) || (data.neighborhood is string && data.neighborhood.size() <= 100)) &&
        data.rating is number && data.rating >= 1 && data.rating <= 5 &&
        data.comment is string && data.comment.size() >= 2 && data.comment.size() <= 500 &&
        data.date is string && data.date.size() >= 4 && data.date.size() <= 30 &&
        data.isVerifiedResident is bool &&
        data.createdAt is timestamp;
    }

    function isEligibleBookingForReview(bookingData, revData) {
      return bookingData.ownerId == request.auth.uid &&
        bookingData.status == 'completed' &&
        ('providerOwnerId' in bookingData) &&
        (bookingData.providerOwnerId == revData.targetId ||
         ('prov-' + bookingData.providerOwnerId) == revData.targetId);
    }

    function isValidAppSettings(data) {
      return data.keys().hasAll(['activeVillageId', 'updatedAt']) &&
        data.keys().hasOnly(['activeVillageId', 'adPriceWeekEgp', 'adPriceMonthEgp', 'commissionRatePercent', 'updatedAt']) &&
        isValidId(data.activeVillageId) &&
        (!('adPriceWeekEgp' in data) || (data.adPriceWeekEgp is number && data.adPriceWeekEgp >= 0 && data.adPriceWeekEgp <= 10000)) &&
        (!('adPriceMonthEgp' in data) || (data.adPriceMonthEgp is number && data.adPriceMonthEgp >= 0 && data.adPriceMonthEgp <= 50000)) &&
        (!('commissionRatePercent' in data) || (data.commissionRatePercent is number && data.commissionRatePercent >= 0 && data.commissionRatePercent <= 50)) &&
        data.updatedAt is timestamp;
    }

    function isValidServiceSection(data) {
      return data.keys().hasAll(['id', 'providerCategoryId', 'nameAr', 'nameEn', 'isEnabled', 'sortOrder', 'isBuiltIn', 'updatedAt']) &&
        data.keys().hasOnly([
          'id', 'providerCategoryId', 'nameAr', 'nameEn', 'descriptionAr', 'descriptionEn',
          'iconKey', 'colorCode', 'isEnabled', 'sortOrder', 'isBuiltIn', 'updatedAt'
        ]) &&
        isValidId(data.id) && data.id.size() <= 40 &&
        isValidId(data.providerCategoryId) && data.providerCategoryId.size() <= 40 &&
        data.nameAr is string && data.nameAr.size() >= 1 && data.nameAr.size() <= 60 &&
        data.nameEn is string && data.nameEn.size() >= 1 && data.nameEn.size() <= 60 &&
        (!('descriptionAr' in data) || (data.descriptionAr is string && data.descriptionAr.size() <= 200)) &&
        (!('descriptionEn' in data) || (data.descriptionEn is string && data.descriptionEn.size() <= 200)) &&
        (!('iconKey' in data) || (data.iconKey is string && data.iconKey.size() <= 32)) &&
        (!('colorCode' in data) || (data.colorCode is string && data.colorCode.size() <= 24)) &&
        data.isEnabled is bool &&
        data.sortOrder is number && data.sortOrder >= 0 && data.sortOrder <= 1000 &&
        data.isBuiltIn is bool &&
        data.updatedAt is timestamp;
    }

    function isValidAnalyticsEvent(data) {
      return data.keys().hasAll(['ownerId', 'eventType', 'targetId', 'villageId', 'createdAtMs', 'createdAt']) &&
        data.keys().hasOnly([
          'ownerId', 'userRole', 'eventType',
          'targetId', 'targetLabel', 'villageId', 'createdAtMs', 'createdAt'
        ]) &&
        isValidId(data.ownerId) &&
        (!('userRole' in data) || (data.userRole in ['resident', 'provider', 'admin', 'guest'])) &&
        data.eventType in ['section_view', 'ad_view', 'ad_click', 'provider_view'] &&
        data.targetId is string && data.targetId.size() >= 1 && data.targetId.size() <= 128 &&
        (!('targetLabel' in data) || (data.targetLabel is string && data.targetLabel.size() <= 120)) &&
        isValidId(data.villageId) &&
        data.createdAtMs is number && data.createdAtMs >= 0 &&
        data.createdAt is timestamp;
    }

    // Villages collection (public read, admin write)
    match /villages/{villageId} {
      allow get: if isValidId(villageId);
      allow list: if true;
      allow create: if isAdmin() && isValidId(villageId) && isValidVillage(incoming()) && incoming().createdAt == request.time;
      allow update: if isAdmin() && isValidId(villageId) && isValidVillage(incoming()) && incoming().createdAt == existing().createdAt;
      allow delete: if isAdmin() && isValidId(villageId);
    }

    // Global platform settings (public read, admin write)
    match /appConfig/{docId} {
      allow get: if isValidId(docId);
      allow list: if true;
      allow create, update: if isAdmin() && isValidId(docId) && isValidAppSettings(incoming()) && incoming().updatedAt == request.time;
      allow delete: if false;
    }

    // Admin marker collection (admin-managed only)
    match /admins/{adminUid} {
      allow get: if isOwner(adminUid) || isAdmin();
      allow list: if isAdmin();
      allow write: if false;
    }

    // Banned Phones collection (admin manages; signed-in can only check a specific normalized phone doc)
    match /bannedPhones/{phoneKey} {
      allow get: if isValidId(phoneKey) && (isSignedIn() || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isAdmin() && isValidId(phoneKey) && isValidBannedPhone(incoming()) && incoming().phone == phoneKey && incoming().createdAt == request.time;
      allow delete: if isAdmin() && isValidId(phoneKey);
    }

    // Per-User Carts (strictly private to owner or admin)
    match /carts/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isValidId(userId) &&
        isOwner(userId) &&
        isVerifiedUser() &&
        isNotBannedUser() &&
        isValidUserCart(incoming()) &&
        incoming().ownerId == request.auth.uid &&
        incoming().updatedAt == request.time;
      allow delete: if isValidId(userId) && (isOwner(userId) || isAdmin());
    }

    // Users collection (Strict PII protection, no self-elevation, ban check)
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId) &&
        isOwner(userId) &&
        isVerifiedUser() &&
        isValidUserProfile(incoming()) &&
        incoming().uid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        (!('isBanned' in incoming()) || incoming().isBanned == false) &&
        (
          (incoming().role == 'resident' && incoming().providerStatus == 'none') ||
          (incoming().role == 'provider' && incoming().providerStatus == 'pending')
        );
      allow update: if isValidId(userId) &&
        isVerifiedUser() &&
        isValidUserProfile(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          isAdmin() ||
          (
            isOwner(userId) &&
            existing().get('isBanned', false) != true &&
            incoming().role == existing().role &&
            incoming().providerStatus == existing().providerStatus &&
            incoming().get('isBanned', false) == existing().get('isBanned', false) &&
            incoming().get('banUntilMs', 0) == existing().get('banUntilMs', 0) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'displayName', 'phone', 'address', 'photoUrl', 'villageId', 'neighborhood',
              'serviceCategory', 'serviceTitle', 'serviceFeeEgp', 'serviceBio', 'updatedAt'
            ])
          )
        );
      allow delete: if isAdmin() && isValidId(userId);
    }

    // Public Service Providers Directory (Pending until Admin approves)
    match /providers/{providerId} {
      allow get: if isValidId(providerId) && (
        existing().status == 'approved' ||
        isOwner(existing().ownerId) ||
        isAdmin()
      );
      allow list: if resource.data.status == 'approved' ||
        (isSignedIn() && resource.data.ownerId == request.auth.uid) ||
        isAdmin();
      allow create: if isValidId(providerId) &&
        isSignedIn() &&
        isVerifiedUser() &&
        isNotBannedUser() &&
        isValidProviderListing(incoming()) &&
        incoming().ownerId == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        (isAdmin() || incoming().status == 'pending');
      allow update: if isValidId(providerId) &&
        isVerifiedUser() &&
        isValidProviderListing(incoming()) &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          isAdmin() ||
          (
            isOwner(existing().ownerId) &&
            isNotBannedUser() &&
            incoming().status == existing().status &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'villageId', 'nameAr', 'nameEn', 'category', 'specialtyAr', 'specialtyEn',
              'phone', 'neighborhoodAr', 'neighborhoodEn', 'priceLabelAr', 'priceLabelEn',
              'bioAr', 'bioEn',
              'isAcceptingOrders', 'manualClosedReason', 'scheduleEnabled', 'openTime', 'closeTime', 'workingDays',
              'updatedAt'
            ])
          )
        );
      allow delete: if isValidId(providerId) && (isAdmin() || isOwner(existing().ownerId));
    }

    // Village Classified Ads (Pending until Admin approves)
    match /ads/{adId} {
      allow get: if isValidId(adId) && (
        existing().status == 'approved' ||
        isOwner(existing().ownerId) ||
        isAdmin()
      );
      allow list: if resource.data.status == 'approved' ||
        (isSignedIn() && resource.data.ownerId == request.auth.uid) ||
        isAdmin();
      allow create: if isValidId(adId) &&
        isSignedIn() &&
        isVerifiedUser() &&
        isNotBannedUser() &&
        isValidVillageAd(incoming()) &&
        incoming().ownerId == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        (isAdmin() || incoming().status == 'pending');
      allow update: if isValidId(adId) &&
        isVerifiedUser() &&
        isValidVillageAd(incoming()) &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          isAdmin() ||
          (
            isOwner(existing().ownerId) &&
            isNotBannedUser() &&
            incoming().status == existing().status &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'title', 'description', 'category', 'priceText', 'contactPhone',
              'durationPlan', 'durationDays', 'costEgp', 'updatedAt'
            ])
          )
        );
      allow delete: if isValidId(adId) && (isAdmin() || isOwner(existing().ownerId));
    }

    // Bookings & Orders
    match /bookings/{bookingId} {
      allow get: if isValidId(bookingId) && (
        isOwner(existing().ownerId) ||
        (isOwner(existing().get('providerOwnerId', '')) && existing().get('providerVisible', true) == true) ||
        isAdmin()
      );
      allow list: if isSignedIn() && (
        resource.data.ownerId == request.auth.uid ||
        (resource.data.get('providerOwnerId', '') == request.auth.uid && resource.data.get('providerVisible', true) == true) ||
        isAdmin()
      );
      allow create: if isValidId(bookingId) &&
        isSignedIn() &&
        isVerifiedUser() &&
        isNotBannedUser() &&
        isValidBooking(incoming()) &&
        incoming().ownerId == request.auth.uid &&
        incoming().createdAt == request.time &&
        (
          isAdmin() ||
          (
            incoming().status == 'pending' &&
            incoming().get('settlementStatus', 'pending') == 'pending' &&
            !('paymentVerifiedAt' in incoming()) &&
            !('settledAt' in incoming()) &&
            !('adminNotes' in incoming()) &&
            incoming().paymentMethod in ['instapay', 'cod'] &&
            incoming().subtotalEgp is number && incoming().subtotalEgp > 0 &&
            incoming().totalAmountEgp is number && incoming().totalAmountEgp > 0 &&
            incoming().totalAmountEgp >= (incoming().subtotalEgp + incoming().get('deliveryFeeEgp', 0) + incoming().get('codFeeEgp', 0) - 0.01) &&
            incoming().totalAmountEgp <= (incoming().subtotalEgp + incoming().get('deliveryFeeEgp', 0) + incoming().get('codFeeEgp', 0) + 0.01) &&
            (
              (incoming().paymentMethod == 'instapay' &&
                incoming().paymentStatus == 'pending_verification' &&
                incoming().providerVisible == false &&
                incoming().get('codFeeEgp', 0) == 0) ||
              (incoming().paymentMethod == 'cod' &&
                incoming().paymentStatus == 'pending_cod' &&
                incoming().providerVisible == true &&
                incoming().get('codFeeEgp', 0) == 10)
            )
          )
        );
      allow update: if isValidId(bookingId) &&
        isVerifiedUser() &&
        isValidBooking(incoming()) &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        (
          isAdmin() ||
          (
            existing().status in ['pending', 'preparing', 'on_the_way', 'confirmed'] &&
            isNotBannedUser() &&
            (
              (
                isOwner(existing().ownerId) &&
                incoming().diff(existing()).affectedKeys().hasOnly(['status']) &&
                incoming().status == 'cancelled'
              ) ||
              (
                isOwner(existing().get('providerOwnerId', '')) &&
                existing().get('providerVisible', true) == true &&
                incoming().diff(existing()).affectedKeys().hasOnly(['status', 'deliveryConfirmedRef', 'deliveryConfirmedAt']) &&
                incoming().status in ['confirmed', 'preparing', 'on_the_way', 'completed', 'cancelled'] &&
                (
                  !(existing().serviceType in ['food', 'pharmacy', 'grocery', 'farm'] && incoming().status == 'completed') ||
                  ('deliveryConfirmedRef' in incoming() && incoming().deliveryConfirmedRef is string && incoming().deliveryConfirmedRef.size() >= 4)
                )
              )
            )
          )
        );
      allow delete: if isAdmin() && isValidId(bookingId);
    }

    // Reviews & Star Ratings
    match /reviews/{reviewId} {
      allow get: if isValidId(reviewId);
      allow list: if true;
      allow create: if isValidId(reviewId) &&
        isSignedIn() &&
        isVerifiedUser() &&
        isNotBannedUser() &&
        isValidReview(incoming()) &&
        incoming().ownerId == request.auth.uid &&
        incoming().isVerifiedResident == true &&
        'bookingId' in incoming() &&
        isValidId(incoming().bookingId) &&
        reviewId == ('rev-' + incoming().bookingId) &&
        exists(/databases/$(database)/documents/bookings/$(incoming().bookingId)) &&
        isEligibleBookingForReview(
          get(/databases/$(database)/documents/bookings/$(incoming().bookingId)).data,
          incoming()
        ) &&
        incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isValidId(reviewId) && (isAdmin() || isOwner(existing().ownerId));
    }

    // Dynamic Service Sections (public read, admin full control)
    match /sections/{sectionId} {
      allow get: if isValidId(sectionId);
      allow list: if true;
      allow create, update: if isAdmin() &&
        isValidId(sectionId) &&
        isValidServiceSection(incoming()) &&
        incoming().id == sectionId &&
        incoming().updatedAt == request.time;
      allow delete: if isAdmin() && isValidId(sectionId);
    }

    // Telemetry: Views, Ad Browsing & Provider Engagement (Admin sees all; verified users write/read own)
    match /analyticsEvents/{eventId} {
      allow get: if isValidId(eventId) && (
        isAdmin() ||
        (isSignedIn() && existing().ownerId == request.auth.uid)
      );
      allow list: if isAdmin() || (isSignedIn() && resource.data.ownerId == request.auth.uid);
      allow create: if isValidId(eventId) &&
        isSignedIn() &&
        isVerifiedUser() &&
        isNotBannedUser() &&
        isValidAnalyticsEvent(incoming()) &&
        incoming().ownerId == request.auth.uid &&
        incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isAdmin() && isValidId(eventId);
    }
  }
}
