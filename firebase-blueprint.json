{
  "entities": {
    "Village": {
      "title": "Village",
      "description": "A modular village configuration supported by the platform.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "nameAr": { "type": "string", "minLength": 1, "maxLength": 80 },
        "nameEn": { "type": "string", "minLength": 1, "maxLength": 80 },
        "governorateAr": { "type": "string", "maxLength": 80 },
        "governorateEn": { "type": "string", "maxLength": 80 },
        "descriptionAr": { "type": "string", "maxLength": 250 },
        "descriptionEn": { "type": "string", "maxLength": 250 },
        "baseDeliveryFeeEgp": { "type": "number" },
        "perKmFeeEgp": { "type": "number" },
        "colorCode": { "type": "string", "enum": ["amber", "emerald", "blue", "teal", "rose", "indigo"] },
        "logoIcon": { "type": "string", "enum": ["wheat", "trees", "landmark", "waves", "sun", "building", "sprout", "compass"] },
        "logoUrl": { "type": "string", "maxLength": 45000 },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "nameAr", "nameEn", "baseDeliveryFeeEgp", "perKmFeeEgp", "isActive", "createdAt"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Private user account profile linked to phone number, optional avatar, and moderation status.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "email": { "type": "string", "maxLength": 120 },
        "phone": { "type": "string", "minLength": 8, "maxLength": 30 },
        "address": { "type": "string", "maxLength": 200 },
        "photoUrl": { "type": "string", "maxLength": 45000 },
        "role": { "type": "string", "enum": ["resident", "provider"] },
        "villageId": { "type": "string", "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "neighborhood": { "type": "string", "maxLength": 100 },
        "providerStatus": { "type": "string", "enum": ["none", "pending", "approved", "rejected"] },
        "serviceCategory": { "type": "string", "maxLength": 40, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "serviceTitle": { "type": "string", "maxLength": 100 },
        "serviceFeeEgp": { "type": "string", "maxLength": 60 },
        "serviceBio": { "type": "string", "maxLength": 400 },
        "isBanned": { "type": "boolean" },
        "banUntilMs": { "type": "number" },
        "banReason": { "type": "string", "maxLength": 200 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName", "phone", "role", "villageId", "providerStatus", "createdAt", "updatedAt"]
    },
    "BannedPhone": {
      "title": "BannedPhone",
      "description": "Phone-number-based timed or permanent ban record enforced by admin.",
      "type": "object",
      "properties": {
        "phone": { "type": "string", "minLength": 8, "maxLength": 30, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 80 },
        "reason": { "type": "string", "maxLength": 200 },
        "banUntilMs": { "type": "number" },
        "isPermanent": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["phone", "banUntilMs", "isPermanent", "createdAt"]
    },
    "UserCart": {
      "title": "UserCart",
      "description": "Per-user persistent shopping cart isolated by user UID.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "villageId": { "type": "string", "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "items": { "type": "array" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "villageId", "items", "updatedAt"]
    },
    "ProviderListing": {
      "title": "ProviderListing",
      "description": "Public service provider application and approved directory entry.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "villageId": { "type": "string", "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "nameAr": { "type": "string", "minLength": 1, "maxLength": 80 },
        "nameEn": { "type": "string", "minLength": 1, "maxLength": 80 },
        "category": { "type": "string", "maxLength": 40, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "specialtyAr": { "type": "string", "minLength": 1, "maxLength": 120 },
        "specialtyEn": { "type": "string", "minLength": 1, "maxLength": 120 },
        "phone": { "type": "string", "minLength": 3, "maxLength": 30 },
        "neighborhoodAr": { "type": "string", "maxLength": 100 },
        "neighborhoodEn": { "type": "string", "maxLength": 100 },
        "priceLabelAr": { "type": "string", "maxLength": 60 },
        "priceLabelEn": { "type": "string", "maxLength": 60 },
        "bioAr": { "type": "string", "maxLength": 400 },
        "bioEn": { "type": "string", "maxLength": 400 },
        "isAcceptingOrders": { "type": "boolean" },
        "manualClosedReason": { "type": "string", "maxLength": 120 },
        "scheduleEnabled": { "type": "boolean" },
        "openTime": { "type": "string", "maxLength": 10, "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$" },
        "closeTime": { "type": "string", "maxLength": 10, "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$" },
        "workingDays": { "type": "array" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "villageId", "nameAr", "nameEn", "category", "specialtyAr", "specialtyEn", "phone", "status", "createdAt", "updatedAt"]
    },
    "VillageAd": {
      "title": "VillageAd",
      "description": "User-submitted classified ad with paid duration tier, automatic expiration, and admin approval.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "authorName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "villageId": { "type": "string", "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "minLength": 2, "maxLength": 120 },
        "description": { "type": "string", "minLength": 4, "maxLength": 500 },
        "category": { "type": "string", "enum": ["offer", "shop", "property", "job", "event"] },
        "priceText": { "type": "string", "maxLength": 60 },
        "contactPhone": { "type": "string", "minLength": 3, "maxLength": 30 },
        "durationPlan": { "type": "string", "enum": ["week", "month"] },
        "durationDays": { "type": "number" },
        "costEgp": { "type": "number" },
        "expiresAtMs": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "authorName", "villageId", "title", "description", "category", "contactPhone", "status", "createdAt", "updatedAt"]
    },
    "Booking": {
      "title": "Booking",
      "description": "Customer order or service booking with payment verification, status tracking, and distance-based delivery calculation.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "villageId": { "type": "string", "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "serviceType": { "type": "string", "maxLength": 40, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 160 },
        "providerOwnerId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "providerName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "customerName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "customerPhone": { "type": "string", "minLength": 3, "maxLength": 30 },
        "address": { "type": "string", "maxLength": 160 },
        "distanceKm": { "type": "number" },
        "deliveryFeeEgp": { "type": "number" },
        "codFeeEgp": { "type": "number" },
        "subtotalEgp": { "type": "number" },
        "totalAmountEgp": { "type": "number" },
        "date": { "type": "string", "maxLength": 40 },
        "time": { "type": "string", "maxLength": 40 },
        "notes": { "type": "string", "maxLength": 400 },
        "itemsSummary": { "type": "string", "maxLength": 400 },
        "paymentMethod": { "type": "string", "enum": ["instapay", "cod"] },
        "paymentStatus": { "type": "string", "enum": ["paid", "pending_verification", "pending_cod", "rejected"] },
        "providerVisible": { "type": "boolean" },
        "instaPaySender": { "type": "string", "maxLength": 60 },
        "instaPayCustomerRef": { "type": "string", "maxLength": 60 },
        "paymentVerifiedAt": { "type": "string", "maxLength": 40 },
        "transactionRef": { "type": "string", "maxLength": 60 },
        "deliveryConfirmedRef": { "type": "string", "maxLength": 60 },
        "deliveryConfirmedAt": { "type": "string", "maxLength": 40 },
        "settlementStatus": { "type": "string", "enum": ["pending", "settled"] },
        "settledAt": { "type": "string", "maxLength": 40 },
        "adminNotes": { "type": "string", "maxLength": 300 },
        "status": { "type": "string", "enum": ["pending", "preparing", "on_the_way", "confirmed", "completed", "cancelled"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "villageId", "serviceType", "title", "providerName", "customerName", "customerPhone", "status", "createdAt"]
    },
    "Review": {
      "title": "Review",
      "description": "Resident review and star rating for a doctor or technician.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "bookingId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "targetId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "villageId": { "type": "string", "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "author": { "type": "string", "minLength": 1, "maxLength": 80 },
        "neighborhood": { "type": "string", "maxLength": 100 },
        "rating": { "type": "number" },
        "comment": { "type": "string", "minLength": 2, "maxLength": 500 },
        "date": { "type": "string", "maxLength": 30 },
        "isVerifiedResident": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "bookingId", "targetId", "villageId", "author", "rating", "comment", "date", "isVerifiedResident", "createdAt"]
    },
    "AppSettings": {
      "title": "AppSettings",
      "description": "Global platform configuration such as active default village, ad pricing, and platform commission rate.",
      "type": "object",
      "properties": {
        "activeVillageId": { "type": "string", "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "adPriceWeekEgp": { "type": "number" },
        "adPriceMonthEgp": { "type": "number" },
        "commissionRatePercent": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["activeVillageId", "updatedAt"]
    },
    "ServiceSection": {
      "title": "ServiceSection",
      "description": "Platform service section/category configured by admin (built-in overrides and custom sections).",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 40, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "providerCategoryId": { "type": "string", "maxLength": 40, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "nameAr": { "type": "string", "minLength": 1, "maxLength": 60 },
        "nameEn": { "type": "string", "minLength": 1, "maxLength": 60 },
        "descriptionAr": { "type": "string", "maxLength": 200 },
        "descriptionEn": { "type": "string", "maxLength": 200 },
        "iconKey": { "type": "string", "maxLength": 32 },
        "colorCode": { "type": "string", "maxLength": 24 },
        "isEnabled": { "type": "boolean" },
        "sortOrder": { "type": "number" },
        "isBuiltIn": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "providerCategoryId", "nameAr", "nameEn", "isEnabled", "sortOrder", "isBuiltIn", "updatedAt"]
    },
    "AnalyticsEvent": {
      "title": "AnalyticsEvent",
      "description": "User browsing, section view, ad view/click, and provider view telemetry event.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userRole": { "type": "string", "enum": ["resident", "provider", "admin", "guest"] },
        "eventType": { "type": "string", "enum": ["section_view", "ad_view", "ad_click", "provider_view"] },
        "targetId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "targetLabel": { "type": "string", "maxLength": 120 },
        "villageId": { "type": "string", "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdAtMs": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "eventType", "targetId", "villageId", "createdAtMs", "createdAt"]
    }
  },
  "firestore": {
    "/villages/{villageId}": {
      "schema": { "$ref": "#/entities/Village" },
      "description": "Modular villages available in the platform."
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private user accounts and service provider applications."
    },
    "/bannedPhones/{phone}": {
      "schema": { "$ref": "#/entities/BannedPhone" },
      "description": "Phone-number bans managed by admin."
    },
    "/carts/{userId}": {
      "schema": { "$ref": "#/entities/UserCart" },
      "description": "Isolated per-user shopping cart."
    },
    "/providers/{providerId}": {
      "schema": { "$ref": "#/entities/ProviderListing" },
      "description": "Publicly visible service providers awaiting or cleared by admin approval."
    },
    "/ads/{adId}": {
      "schema": { "$ref": "#/entities/VillageAd" },
      "description": "Village classified ads requiring admin approval before public display."
    },
    "/bookings/{bookingId}": {
      "schema": { "$ref": "#/entities/Booking" },
      "description": "Customer appointments, orders, and distance-based delivery receipts."
    },
    "/reviews/{reviewId}": {
      "schema": { "$ref": "#/entities/Review" },
      "description": "Star ratings and resident feedback for providers."
    },
    "/appConfig/{docId}": {
      "schema": { "$ref": "#/entities/AppSettings" },
      "description": "Global platform configuration controlled by admin."
    },
    "/sections/{sectionId}": {
      "schema": { "$ref": "#/entities/ServiceSection" },
      "description": "Dynamic service categories/sections managed by admin."
    },
    "/analyticsEvents/{eventId}": {
      "schema": { "$ref": "#/entities/AnalyticsEvent" },
      "description": "Views, ad browsing, and provider view events per user."
    }
  }
}
