# Server configuration
PORT=3000
NODE_ENV=development

# APP_URL: Public base URL where the application is hosted.
APP_URL="http://localhost:3000"

# VITE_RECAPTCHA_SITE_KEY: Optional reCAPTCHA v3 site key to activate Firebase App Check on client requests.
VITE_RECAPTCHA_SITE_KEY=""

# FIREBASE_SERVICE_ACCOUNT_JSON: Optional single-line Firebase service account JSON string
# used by /api/admin/delete-user and /api/auth/check-ban (falls back to GOOGLE_APPLICATION_CREDENTIALS if set).
FIREBASE_SERVICE_ACCOUNT_JSON=""
