# Server configuration
PORT=3000
NODE_ENV=development

# GEMINI_API_KEY: Optional API key for the server-side Village AI Assistant (/api/village-assistant).
# If omitted, the endpoint returns a localized fallback response.
GEMINI_API_KEY=""

# GEMINI_MODEL: Gemini model ID used by /api/village-assistant (defaults to gemini-4-hydrogen).
GEMINI_MODEL="gemini-4-hydrogen"

# APP_URL: Public base URL where the application is hosted.
APP_URL="http://localhost:3000"

# VITE_RECAPTCHA_SITE_KEY: Optional reCAPTCHA v3 site key to activate Firebase App Check on client requests.
VITE_RECAPTCHA_SITE_KEY=""

# FIREBASE_SERVICE_ACCOUNT_JSON: Optional single-line Firebase service account JSON string
# used by /api/admin/delete-user and /api/auth/check-ban (falls back to GOOGLE_APPLICATION_CREDENTIALS if set).
FIREBASE_SERVICE_ACCOUNT_JSON=""
